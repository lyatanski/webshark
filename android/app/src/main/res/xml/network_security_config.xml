<?xml version="1.0" encoding="utf-8"?>
<!-- The one address this app is allowed to speak plaintext to is the server it
     started itself. Everything else stays refused, which is the default from
     API 28 on and is left saying so out loud. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
